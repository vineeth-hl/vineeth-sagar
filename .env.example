# ---- Hero "Now Playing" widget (bottom-left) — live Spotify status ----
# via the keyless Lanyard API, which mirrors your Discord presence.
#   1. Join the Lanyard Discord:  https://discord.gg/lanyard
#   2. Discord -> Settings -> Connections -> connect Spotify
#   3. Discord -> Settings -> Advanced -> Developer Mode on,
#      right-click your username -> Copy User ID
#   4. Copy this file to .env.local, paste the id, restart `npm run dev`.
# Blank -> the card shows its last-played cache, then an "Offline" placeholder.
VITE_LANYARD_ID=1489321223497191425

# ---- Hero "Latest on YouTube" widget (bottom-right) — your newest upload ----
# via the YouTube Data API v3.
#   1. console.cloud.google.com -> new project -> APIs & Services -> Library
#      -> enable "YouTube Data API v3"
#   2. Credentials -> Create Credentials -> API key
#   3. Restrict it: Application restrictions = Websites
#      (vineethsagar.co.in/*, *.vineethsagar.co.in/*, localhost:5173/*);
#      API restrictions = YouTube Data API v3 only
#   4. Channel ID: YouTube Studio -> Settings -> Channel -> Advanced (UC…)
# Blank -> the card shows an "Offline" placeholder (layout unaffected).
VITE_YOUTUBE_API_KEY=
VITE_YOUTUBE_CHANNEL_ID=
